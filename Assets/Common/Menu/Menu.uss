.menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 8, 16, 0.75);
}

.panel {
    min-width: 760px;
    padding: 36px 44px;
    background-color: rgba(14, 18, 30, 0.96);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(120, 140, 180, 0.35);
}

.title {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(255, 214, 102);
}

.subtitle {
    font-size: 22px;
    color: rgb(170, 190, 220);
    margin-bottom: 18px;
}

.section {
    font-size: 18px;
    color: rgb(120, 140, 180);
    margin-top: 14px;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.steps {
    flex-direction: column;
}

.counts, .row {
    flex-direction: row;
    flex-wrap: wrap;
}

.button {
    font-size: 24px;
    padding: 10px 18px;
    margin: 4px 6px 4px 0;
    background-color: rgb(34, 42, 64);
    color: rgb(240, 240, 240);
    border-width: 0;
    border-radius: 6px;
    -unity-text-align: middle-left;
}

.button:hover {
    background-color: rgb(58, 72, 108);
}

.button.step {
    width: 100%;
}

.button.count {
    min-width: 120px;
    -unity-text-align: middle-center;
}

.button.count.selected {
    background-color: rgb(255, 214, 102);
    color: rgb(20, 24, 36);
}

.button.auto {
    font-size: 20px;
    background-color: rgb(44, 78, 70);
}

.button.auto:hover {
    background-color: rgb(60, 110, 96);
}

.status {
    margin-top: 14px;
    font-size: 20px;
    color: rgb(255, 214, 102);
    white-space: normal;
}

.hint {
    margin-top: 16px;
    font-size: 16px;
    color: rgb(120, 140, 180);
}

.corner {
    position: absolute;
    right: 24px;
    top: 24px;
    flex-direction: row;
}

.back {
    margin-left: 10px;
    font-size: 22px;
    padding: 8px 16px;
    background-color: rgba(34, 42, 64, 0.85);
    color: rgb(240, 240, 240);
    border-width: 0;
    border-radius: 6px;
}

.back:hover {
    background-color: rgb(58, 72, 108);
}
